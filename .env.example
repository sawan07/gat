# Required
OPENAI_API_KEY=sk-...

# Stripe: Global Alliance Trust's own account (donations are paid into it).
# sk_test_... for testing, sk_live_... for real donations. Unset = no payment links.
STRIPE_SECRET_KEY=sk_test_...
# Where Stripe sends donors back to after paying (/thank-you)
GAT_PUBLIC_URL=https://gat.amverio.co.uk

# Optional
GAT_MODEL=gpt-4.1
# Set to 0 if Global Alliance Trust is not registered with HMRC for Gift Aid
GAT_GIFT_AID=1
# Per-visitor message limits
GAT_RATE_PER_10MIN=30
GAT_RATE_PER_DAY=150

# WordPress Donations admin (values from WordPress > Settings > GAT Settings).
# Use the SAME Stripe account (STRIPE_SECRET_KEY) as the WordPress site, so its
# webhook can mark these donations as paid.
GAT_WP_URL=https://gat-site.amverio.co.uk
GAT_WP_SECRET=
